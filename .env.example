# ============================================================
# RPA-CS01 - Predicta
# Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores se necessário
# ============================================================

# APLICAÇÃO
APP_NAME=RPA-CS01-Predicta
APP_ENV=development
LOG_LEVEL=INFO

# BANCO DE DADOS
DATABASE_PATH=database/motores.db

# DATASET / PIPELINE
DATASET_PATH=data/processed/leituras_MTR-001_2026.csv
BATCH_SIZE=50

# DASHBOARD (Gradio)
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860

# LIMITES DE CLASSIFICAÇÃO DE ANOMALIAS
TEMP_CRITICA=85.0
VIBRACAO_CRITICA=7.0
CORRENTE_CRITICA=50.0

# ============================================================
# SPRINT 4 - INTEGRAÇÃO E SUPORTE OPERACIONAL
# ============================================================
INTERVALO_CICLO_S=20            # segundos entre ciclos no modo contínuo
CICLOS_PARA_RESOLVER=3          # leituras normais seguidas para encerrar um evento
LIMIAR_ALERTA=0.9               # fração do limite que já gera ALERTA
TENSAO_NOMINAL_PADRAO=380       # usada quando o motor não tem placa cadastrada
RETRY_TENTATIVAS=3
PREDICTA_USAR_LLM=auto          # auto | sim | nao  (nao = só regras + base de conhecimento)
OLLAMA_MODELO=llama3.2
OLLAMA_TIMEOUT_S=25
PREDICTA_RAG_BACKEND=auto       # auto | semantico | lexical
# CATALOGO_URL=https://exemplo.com/catalogo   # vazio = usa o catálogo local de exemplo
